---
interface Props {
  src: string;
  title: string;
  height?: string;
}

const { src, title, height = '400px' } = Astro.props;
---

<div class="rounded-xl overflow-hidden shadow-md border border-slate-200" style={`height: ${height}`}>
  <iframe
    src={src}
    title={title}
    width="100%"
    height="100%"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    class="border-0"
  ></iframe>
</div>
