---
---

<div class="overflow-x-auto">
  <table class="w-full text-sm">
    <thead>
      <tr style="border-bottom: 1px solid rgba(255,255,255,0.15);">
        <th class="text-left pb-3 pr-6 text-xs uppercase" style="letter-spacing: 0.2rem; color: rgba(255,255,255,0.4);">Period</th>
        <th class="pb-3 px-4 text-center text-xs uppercase" style="letter-spacing: 0.2rem; color: rgba(255,255,255,0.4);">Solo 10km</th>
        <th class="pb-3 px-4 text-center text-xs uppercase" style="letter-spacing: 0.2rem; color: rgba(255,255,255,0.4);">Solo 5km</th>
        <th class="pb-3 px-4 text-center text-xs uppercase" style="letter-spacing: 0.2rem; color: rgba(255,255,255,0.4);">Trio team</th>
        <th class="pb-3 px-4 text-center text-xs uppercase" style="letter-spacing: 0.2rem; color: rgba(255,255,255,0.4);">Trio / person</th>
      </tr>
    </thead>
    <tbody>
      {[
        { label: 'Early Bird', dates: 'Jan 8 – Feb 14', solo10: '€100', solo5: '€70', team: '€170', pp: '€57' },
        { label: 'Full On', dates: 'Feb 15 – Jun 30', solo10: '€130', solo5: '€90', team: '€220', pp: '€74' },
        { label: 'Last Minute', dates: 'Jul 1 – Aug 12', solo10: '€180', solo5: '€120', team: '€300', pp: '€100' },
      ].map((row) => (
        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
          <td class="py-4 pr-6">
            <p class="font-semibold text-white">{row.label}</p>
            <p class="text-xs mt-0.5" style="color: rgba(255,255,255,0.4);">{row.dates}</p>
          </td>
          <td class="py-4 px-4 text-center font-bold">{row.solo10}</td>
          <td class="py-4 px-4 text-center font-bold">{row.solo5}</td>
          <td class="py-4 px-4 text-center font-bold">{row.team}</td>
          <td class="py-4 px-4 text-center font-bold">{row.pp}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
