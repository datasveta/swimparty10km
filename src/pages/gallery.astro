---

<Base title="Gallery" description="Photos from SwimParty 10km editions.">

  <!-- Header -->
  <section class="panel-transparent py-24 text-center px-6">
    <h1 class="font-display uppercase mb-4 page-title">Gallery</h1>
    <p style="color: rgba(255,255,255,0.7); font-size: 1.1rem;">2024, 2025 &amp; 2026 editions.</p>
  </section>

  <!-- 2026 -->
  <section class="panel py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="font-display text-2xl uppercase mb-2" style="letter-spacing:0.05em;">2026</h2>
      <p class="mb-6" style="color:rgba(255,255,255,0.7);font-size:0.95rem;">
        Photography: {credits['2026'].name}
        <a href={credits['2026'].url} target="_blank" rel="noopener noreferrer" style="text-decoration:underline;">{credits['2026'].handle}</a>
      </p>
      <hr class="carrd-rule" />
      <div class="gallery-grid">
        {gallery2026.map((filename, i) => (
          <button
            class="gallery-item"
            data-gallery="2026"
            data-index={String(i)}
            aria-label={`Open photo ${i + 1} of ${gallery2026.length}`}
          >
            <img
              src={`/images/gallery/2026/${filename}`}
              alt={`SwimParty 2026 — photo ${i + 1}`}
              loading="lazy"
            />
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- 2025 -->
  <section class="panel py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="font-display text-2xl uppercase mb-6" style="letter-spacing:0.05em;">2025</h2>
      <hr class="carrd-rule" />
      {gallery2025.length > 0 ? (
        <div class="gallery-grid">
          {gallery2025.map((filename, i) => (
            <button
              class="gallery-item"
              data-gallery="2025"
              data-index={String(i)}
              aria-label={`Open photo ${i + 1} of ${gallery2025.length}`}
            >
              <img
                src={`/images/gallery/2025/${filename}`}
                alt={`SwimParty 2025 — photo ${i + 1}`}
                loading="lazy"
              />
            </button>
          ))}
        </div>
      ) : (
        <p style="color:rgba(255,255,255,0.35);font-size:0.875rem;font-style:italic;">
          No 2025 photos yet.
        </p>
      )}
    </div>
  </section>

  <!-- 2024 -->
  <section class="panel py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="font-display text-2xl uppercase mb-6" style="letter-spacing:0.05em;">2024</h2>
      <hr class="carrd-rule" />
      {gallery2024.length > 0 ? (
        <div class="gallery-grid">
          {gallery2024.map((filename, i) => (
            <button
              class="gallery-item"
              data-gallery="2024"
              data-index={String(i)}
              aria-label={`Open photo ${i + 1} of ${gallery2024.length}`}
            >
              <img
                src={`/images/gallery/2024/${filename}`}
                alt={`SwimParty 2024 — photo ${i + 1}`}
                loading="lazy"
              />
            </button>
          ))}
        </div>
      ) : (
        <p style="color:rgba(255,255,255,0.35);font-size:0.875rem;font-style:italic;">
          No 2024 photos yet.
        </p>
      )}
    </div>
  </section>

  <script type="application/json" id="gallery-credits" set:html={JSON.stringify(credits)} />

  <!-- Lightbox — must be inside Base so it lands inside <body> -->
  <div id="lb-overlay" aria-modal="true" role="dialog" aria-label="Photo viewer">
    <button id="lb-close" aria-label="Close">&#x2715;</button>
    <button id="lb-prev" aria-label="Previous photo">&#8249;</button>
    <div id="lb-img-wrap">
      <img id="lb-photo" src="" alt="" />
      <div id="lb-credit" hidden>
        <p id="lb-disclaimer">
          Love this photo? Follow <a id="lb-follow" href="#" target="_blank" rel="noopener noreferrer"></a> on Instagram
          and please credit the photographer when you share it — click Download to copy the credit line.
        </p>
        <button id="lb-download" type="button">Download</button>
        <div id="lb-copy-panel" hidden>
          <span id="lb-credit-text"></span>
          <button id="lb-copy" type="button">Copy</button>
        </div>
      </div>
    </div>
    <button id="lb-next" aria-label="Next photo">&#8250;</button>
    <p id="lb-counter"></p>
  </div>

</Base>

<style is:global>
  /* Gallery grid */
  .gallery-grid {
    columns: 2;
    column-gap: 0.5rem;
  }
  @media (min-width: 640px) { .gallery-grid { columns: 3; } }
  @media (min-width: 900px) { .gallery-grid { columns: 4; } }

  .gallery-item {
    display: block;
    break-inside: avoid;
    margin-bottom: 0.5rem;
    overflow: hidden;
    cursor: zoom-in;
    padding: 0;
    background: none;
    border: none;
    width: 100%;
  }
  .gallery-item img {
    width: 100%;
    display: block;
    transition: transform 0.3s ease, opacity 0.2s;
  }
  .gallery-item:hover img { transform: scale(1.03); opacity: 0.82; }

  /* Lightbox */
  #lb-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,0.94);
    align-items: center;
    justify-content: center;
    padding: 3.5rem 0.5rem 2.5rem;
  }
  #lb-overlay.open { display: flex; }

  #lb-img-wrap {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.75rem;
    overflow: hidden;
    max-height: 100%;
  }
  #lb-overlay.has-credit #lb-photo { max-height: 64vh; }
  #lb-photo {
    max-width: 100%;
    max-height: 82vh;
    object-fit: contain;
    border-radius: 2px;
    box-shadow: 0 0 80px rgba(0,0,0,0.9);
    transition: opacity 0.15s ease;
  }
  #lb-photo.fading { opacity: 0; }

  #lb-credit {
    text-align: center;
    color: rgba(255,255,255,0.7);
    font-size: 0.8rem;
    line-height: 1.4;
    max-width: 34rem;
  }
  #lb-credit a { color: #fff; text-decoration: underline; }
  #lb-disclaimer { margin: 0 0 0.6rem; }
  #lb-download, #lb-copy {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
    color: #fff;
    background: none;
    border: 1px solid rgba(255,255,255,0.5);
    padding: 0.45rem 1rem;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  #lb-download:hover, #lb-copy:hover { background: rgba(255,255,255,0.12); border-color: #fff; }
  #lb-copy-panel {
    margin-top: 0.75rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid rgba(255,255,255,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  #lb-copy-panel[hidden], #lb-credit[hidden] { display: none; }

  #lb-close {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    font-size: 1.75rem;
    line-height: 1;
    color: rgba(255,255,255,0.6);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem 0.6rem;
    z-index: 2;
    transition: color 0.15s;
  }
  #lb-close:hover { color: #fff; }

  #lb-prev, #lb-next {
    flex-shrink: 0;
    font-size: 3.5rem;
    line-height: 1;
    color: rgba(255,255,255,0.5);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem 1.25rem;
    transition: color 0.15s, transform 0.15s;
    user-select: none;
  }
  #lb-prev:hover, #lb-next:hover { color: #fff; transform: scale(1.12); }
  #lb-prev:disabled, #lb-next:disabled { opacity: 0.12; cursor: default; transform: none; }

  #lb-counter {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Didact Gothic', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.25rem;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    white-space: nowrap;
  }

  @media (max-width: 540px) {
    #lb-prev, #lb-next { font-size: 2.5rem; padding: 0.5rem 0.6rem; }
  }
</style>

<script>
  (function () {
    const overlay = document.getElementById('lb-overlay');
    const photo   = document.getElementById('lb-photo') as HTMLImageElement | null;
    const prev    = document.getElementById('lb-prev') as HTMLButtonElement | null;
    const next    = document.getElementById('lb-next') as HTMLButtonElement | null;
    const closeBtn = document.getElementById('lb-close');
    const counter = document.getElementById('lb-counter');
    const creditBox = document.getElementById('lb-credit');
    const followLink = document.getElementById('lb-follow') as HTMLAnchorElement | null;
    const downloadBtn = document.getElementById('lb-download');
    const copyPanel = document.getElementById('lb-copy-panel');
    const creditText = document.getElementById('lb-credit-text');
    const copyBtn = document.getElementById('lb-copy');

    const credits: Record<string, { name: string; handle: string; url: string }> =
      JSON.parse(document.getElementById('gallery-credits')?.textContent || '{}');

    if (!overlay || !photo || !prev || !next) return;

    // Build image lists per gallery group
    const groups: Record<string, { src: string; alt: string }[]> = {};
    document.querySelectorAll<HTMLElement>('.gallery-item').forEach(btn => {
      const g = btn.dataset.gallery!;
      const idx = Number(btn.dataset.index);
      const img = btn.querySelector('img') as HTMLImageElement;
      if (!groups[g]) groups[g] = [];
      groups[g][idx] = { src: img.src, alt: img.alt };
    });

    let activeGroup = '';
    let activeIdx = 0;
    let pushed = false; // true when opening the lightbox added a history entry

    // Each photo has a shareable link: /gallery#2026-42 (year-photo number)
    const photoUrl = (g: string, idx: number) =>
      `${location.pathname}${location.search}#${g}-${idx + 1}`;

    function updateCredit(g: string) {
      const c = credits[g];
      overlay.classList.toggle('has-credit', !!c);
      if (!creditBox || !copyPanel) return;
      creditBox.hidden = !c;
      copyPanel.hidden = true;
      if (copyBtn) copyBtn.textContent = 'Copy';
      if (!c) return;
      if (followLink) { followLink.href = c.url; followLink.textContent = c.handle; }
      if (creditText) creditText.textContent = `Photographer: ${c.name} ${c.handle}`;
    }

    function navigate(g: string, idx: number) {
      const list = groups[g];
      activeGroup = g;
      activeIdx = idx;
      updateCredit(g);
      if (overlay.classList.contains('open')) history.replaceState(null, '', photoUrl(g, idx));
      photo.classList.add('fading');
      setTimeout(() => {
        photo.src = list[idx].src;
        photo.alt = list[idx].alt;
        photo.classList.remove('fading');
      }, 120);
      if (counter) counter.textContent = `${idx + 1} / ${list.length}`;
      prev.disabled = idx === 0;
      next.disabled = idx === list.length - 1;
    }

    function openLightbox(g: string, idx: number, push = true) {
      const wasOpen = overlay.classList.contains('open');
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
      if (push && !wasOpen) { history.pushState(null, '', photoUrl(g, idx)); pushed = true; }
      navigate(g, idx);
    }

    function closeLightbox(fromHistory = false) {
      overlay.classList.remove('open');
      document.body.style.overflow = '';
      photo.src = '';
      if (fromHistory) { pushed = false; return; }
      if (pushed) { pushed = false; history.back(); }
      else history.replaceState(null, '', location.pathname + location.search);
    }

    // Open / close in response to the URL hash (page load, back/forward, pasted link)
    function syncFromHash() {
      const m = /^#(\d{4})-(\d+)$/.exec(location.hash);
      const list = m && groups[m[1]];
      const idx = m ? Number(m[2]) - 1 : -1;
      if (list && idx >= 0 && idx < list.length) {
        if (overlay.classList.contains('open')) navigate(m![1], idx);
        else openLightbox(m![1], idx, false);
      } else if (overlay.classList.contains('open')) {
        closeLightbox(true);
      }
    }
    window.addEventListener('popstate', syncFromHash);

    // Thumbnail clicks
    document.querySelectorAll<HTMLElement>('.gallery-item').forEach(btn => {
      btn.addEventListener('click', () => {
        openLightbox(btn.dataset.gallery!, Number(btn.dataset.index));
      });
    });

    // Download + credit copy
    downloadBtn?.addEventListener('click', e => {
      e.stopPropagation();
      const a = document.createElement('a');
      a.href = groups[activeGroup][activeIdx].src;
      a.download = a.href.split('/').pop() || 'swimparty-photo.jpg';
      document.body.appendChild(a);
      a.click();
      a.remove();
      if (copyPanel) copyPanel.hidden = false;
    });
    copyBtn?.addEventListener('click', async e => {
      e.stopPropagation();
      const text = creditText?.textContent || '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      copyBtn.textContent = 'Copied ✓';
    });
    creditBox?.addEventListener('click', e => e.stopPropagation());

    // Prev / next
    prev.addEventListener('click', e => {
      e.stopPropagation();
      if (activeIdx > 0) navigate(activeGroup, activeIdx - 1);
    });
    next.addEventListener('click', e => {
      e.stopPropagation();
      if (activeIdx < groups[activeGroup].length - 1) navigate(activeGroup, activeIdx + 1);
    });

    // Close
    closeBtn?.addEventListener('click', e => { e.stopPropagation(); closeLightbox(); });
    overlay.addEventListener('click', () => closeLightbox());

    // Keyboard
    document.addEventListener('keydown', e => {
      if (!overlay.classList.contains('open')) return;
      if (e.key === 'ArrowLeft')  { e.preventDefault(); if (activeIdx > 0) navigate(activeGroup, activeIdx - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); if (activeIdx < groups[activeGroup].length - 1) navigate(activeGroup, activeIdx + 1); }
      if (e.key === 'Escape') closeLightbox();
    });

    syncFromHash();

    // Touch swipe
    let touchX = 0;
    overlay.addEventListener('touchstart', e => { touchX = e.touches[0].clientX; }, { passive: true });
    overlay.addEventListener('touchend', e => {
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) < 40) return;
      if (dx < 0 && activeIdx < groups[activeGroup].length - 1) navigate(activeGroup, activeIdx + 1);
      if (dx > 0 && activeIdx > 0) navigate(activeGroup, activeIdx - 1);
    });
  })();
</script>
