---
import Base from '../layouts/Base.astro';
---

<Base title="SwimParty 10km" description="Ever dreamt of swimming and partying together? September 11, 2027 — Algarve, Portugal.">

  <!-- Hero -->
  <section class="panel-transparent min-h-screen flex flex-col items-center justify-center text-center px-6 py-24">
    <h1 class="font-display page-title text-white leading-tight mb-8" style="text-transform:uppercase;">
      Ever dreamt of swimming<br />and partying together?
    </h1>
    <p class="text-sm uppercase mb-2" style="letter-spacing:0.325rem;color:rgba(255,255,255,0.65);">Save the date:</p>
    <p class="font-display text-3xl md:text-4xl mb-10" style="color:#DF206C;text-transform:uppercase;letter-spacing:0.05em;">September 11 2027</p>

    <!-- Countdown -->
    <div class="flex gap-8 md:gap-12 mb-12 text-center">
      {['days','hours','minutes','seconds'].map((unit) => (
        <div>
          <span class="font-display text-3xl md:text-5xl text-white" id={`cd-${unit}`}>--</span>
          <p class="text-xs uppercase mt-1" style="letter-spacing:0.2rem;color:rgba(255,255,255,0.45);">{unit}</p>
        </div>
      ))}
    </div>

    <p class="text-xs uppercase mb-4" style="letter-spacing:0.15rem;color:rgba(255,255,255,0.5);">Registration coming soon — subscribe to get updates</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/contact#subscribe" class="btn btn-pink">Get updates</a>
      <a href="/race" class="btn">I'm curious</a>
    </div>
  </section>

  <!-- 2026 recap video -->
  <section class="panel py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="section-heading mb-6">Relive 2026</h2>
      <hr class="carrd-rule" />
      <div class="home-video-wrap">
        <iframe
          src="https://drive.google.com/file/d/1vylbcM9GWGfqH3WpWnIS9K9qyT8i9FMn/preview"
          title="SwimParty 2026 aftermovie"
          loading="lazy"
          allow="autoplay; fullscreen"
          allowfullscreen
        ></iframe>
      </div>
      <p class="text-xs mt-3" style="color:rgba(255,255,255,0.5);">
        <a href="https://drive.google.com/file/d/1vylbcM9GWGfqH3WpWnIS9K9qyT8i9FMn/view" target="_blank" rel="noopener noreferrer" style="color:rgba(255,255,255,0.5);text-decoration:underline;">Watch on Google Drive ↗</a>
        &nbsp;·&nbsp;
        <a href="/gallery" style="color:rgba(255,255,255,0.5);text-decoration:underline;">See the full gallery →</a>
      </p>
    </div>
  </section>

  <!-- WHAT — text left, image right -->
  <section class="panel py-0">
    <div class="col-split img-right">
      <div class="col-text">
        <h2 class="section-heading mb-6">What?</h2>
        <hr class="carrd-rule" />
        <p class="leading-relaxed mb-4" style="color:rgba(255,255,255,0.85);">
          Celebration of swimming, community and the beautiful Carvoeiro–Ferragudo coast (Algarve)
        </p>
        <p class="leading-relaxed mb-8" style="color:rgba(255,255,255,0.85);">
          Distances:<br />
          &bull; Solo 5km, 10km<br />
          &bull; Trio relay 10km (3.2 km + 1.8 km + 5 km)
        </p>
        <div><a href="/race" class="btn">I'm curious</a></div>
      </div>
      <div class="col-img">
        <img src="/images/content/swimming.jpg" alt="Swimming at the Algarve coast" />
      </div>
    </div>
  </section>

  <!-- WHEN AND WHERE — image left, text right -->
  <section class="panel py-0">
    <div class="col-split">
      <div class="col-img">
        <img src="/images/content/coast.jpg" alt="Algarve coast" />
      </div>
      <div class="col-text">
        <h2 class="section-heading mb-6">When and where?</h2>
        <hr class="carrd-rule" />
        <p class="leading-relaxed mb-8" style="color:rgba(255,255,255,0.85);">
          11 September 2027<br />
          From Benagil and Carvoeiro beaches to Ferragudo Praia dos Caneiros
        </p>
        <div><a href="/race" class="btn">I'm convinced</a></div>
      </div>
    </div>
  </section>

  <!-- HOW — text left, image right -->
  <section class="panel py-0">
    <div class="col-split img-right">
      <div class="col-text">
        <h2 class="section-heading mb-6">How?</h2>
        <hr class="carrd-rule" />
        <p class="leading-relaxed mb-3" style="color:rgba(255,255,255,0.85);">Logistics and support:</p>
        <ul class="bullets mb-8" style="color:rgba(255,255,255,0.85);">
          <li>Swimmers will use <strong>tow floats</strong> for identification</li>
          <li><strong>Time log</strong> for all swimmers</li>
          <li><strong>Precision Fuel &amp; Hydration</strong> products supplied</li>
          <li><strong>Marine Police</strong> security during the race</li>
          <li><strong>Feeding stations</strong> along the race</li>
          <li><strong>Medical</strong> support</li>
          <li><strong>Buoys</strong> labeling the race route</li>
        </ul>
        <div><a href="/race" class="btn">Ok, I'm in!</a></div>
      </div>
      <div class="col-img">
        <img src="/images/content/support.jpg" alt="Open water swimming support" />
      </div>
    </div>
  </section>

  <!-- Quote -->
  <section class="panel py-24 text-center px-6">
    <div class="max-w-3xl mx-auto">
      <h2 class="section-heading mb-8">Start your journey today</h2>
      <hr class="carrd-rule" />
      <blockquote class="text-xl md:text-2xl italic leading-relaxed mb-6" style="color:rgba(255,255,255,0.85);">
        "The true test of a champion is not whether he can triumph, but whether he can overcome the obstacles."
      </blockquote>
      <cite class="text-xs uppercase not-italic" style="letter-spacing:0.325rem;color:rgba(255,255,255,0.5);">Garth Stein</cite>
    </div>
  </section>

  <!-- Registration CTA -->
  <section class="panel py-24 text-center px-6">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-display text-3xl md:text-4xl uppercase mb-6" style="color:#DF206C;letter-spacing:0.05em;">Registration coming soon</h2>
      <hr class="carrd-rule" />
      <p class="leading-relaxed mb-4" style="color:rgba(255,255,255,0.85);">
        Registration for 2027 isn't open yet. Subscribe to our newsletter and we'll let you know the moment it launches.
      </p>
      <p class="leading-relaxed mb-10" style="color:rgba(255,255,255,0.85);">
        The registration fee will include participation with an electronic chip, an official event swim cap, an event t-shirt, nutrition, drinks, support in and out of the water, safety, transport for departure and arrival and access to the post-event party, which includes lunch on the beach.
      </p>
      <a href="/contact#subscribe" class="btn btn-pink">Subscribe for updates</a>
    </div>
  </section>

</Base>

<style>
  .home-video-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: rgba(255,255,255,0.03);
  }
  .home-video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .col-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 90vh;
  }
  .col-img { overflow: hidden; }
  .col-img img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .col-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 3.5rem;
  }
  @media (max-width: 767px) {
    .col-split { grid-template-columns: 1fr; min-height: auto; }
    .col-img { height: 55vw; min-height: 220px; }
    .col-split.img-right .col-img { order: -1; }
    .col-text { padding: 2.5rem 1.5rem; }
  }
</style>

<script>
  function tick() {
    const diff = new Date('2027-09-11T08:00:00').getTime() - Date.now();
    if (diff <= 0) return;
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    const set = (id: string, v: number) => { const el = document.getElementById(id); if (el) el.textContent = String(v).padStart(2,'0'); };
    set('cd-days', d); set('cd-hours', h); set('cd-minutes', m); set('cd-seconds', s);
  }
  tick(); setInterval(tick, 1000);
</script>
