---
import Base from '../layouts/Base.astro';
---

<Base title="Plan your visit" description="Swim Week September 2027 — morning sea swims, yoga, sunset drinks with Olympic athletes, and hotel partners.">

  <section class="panel-transparent py-24 text-center px-6">
    <p class="text-xs uppercase mb-4" style="letter-spacing:0.325rem;color:rgba(255,255,255,0.6);">September 2027 · Algarve</p>
    <h1 class="font-display uppercase mb-4 page-title">Swim Week</h1>
    <p style="color:rgba(255,255,255,0.7);">A full week of ocean, community, and coastline — beyond the race.</p>
  </section>

  <section class="panel py-20">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="section-heading mb-6">What's on</h2>
      <hr class="carrd-rule" />
      <div class="space-y-10">
        {[
          { when: 'Last year: daily, early morning', title: 'Morning Guided Swims', text: 'Last year, everyone able to arrive early swam together every morning — meeting at the beach, getting in the water for 2–4 km along the coastline, then regrouping for breakfast at a local café. Expect the same rhythm in 2027 — exact times to be confirmed.' },
          {
            when: 'Last year: one evening, mid-week',
            title: 'Sunset Drinks & Olympic Talks',
            text: 'Last year we gathered at a beachfront resort for sunset cocktails, live music, and an inspiring talk from an Olympic athlete. We\'re planning something similar for 2027 — details coming soon.',
          },
          { when: 'Last year: daily sessions', title: 'Movement & Preparation', text: 'Stretching, yoga, and pilates sessions throughout the week, all levels welcome. Expect similar sessions in 2027 — schedule to be confirmed.' },
          { when: 'Last year: throughout the week', title: 'Cultural & Algarve Experiences', text: 'Local village exploration, coastal landscape tours, gastronomy experiences, and historic site visits. We\'re planning a similar programme for 2027 — details coming soon.' },
          { when: 'Saturday September 11, 2027', title: 'Race Day + Beach Party', text: 'All three distances will start with staggered wave starts. The day closes with the post-race beach party and lunch, included for all registered participants.' },
        ].map(({ when, title, text }) => (
          <div>
            <p class="text-xs uppercase mb-2" style="letter-spacing:0.25rem;color:rgba(255,255,255,0.5);">{when}</p>
            <h3 class="text-base font-bold mb-3" style="text-transform:uppercase;letter-spacing:0.12rem;">{title}</h3>
            <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.75);" set:html={text} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="panel py-20">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="section-heading mb-6">Accommodation partners</h2>
      <hr class="carrd-rule" />
      <p class="text-sm mb-10" style="color:rgba(255,255,255,0.5);">Partner discounts for SwimParty 10km participants — details coming soon.</p>
      <div class="grid md:grid-cols-3 gap-8">
        {[
          { name: 'Mirachoro Carvoeiro Hotel', url: 'https://www.online-reservations.com/?hotelid=39473' },
          { name: 'Vale da Lapa Village Resort', url: 'https://www.valedalapa.com/pt' },
          { name: 'Go rustic — Animame Algarve · Alcantarilha' },
        ].map(({ name, url }) => (
          <div style="border:1px solid rgba(255,255,255,0.15);padding:2rem;">
            <h3 class="font-bold text-base mb-1">
              {url ? <a href={url} target="_blank" rel="noopener noreferrer" class="hotel-link">{name} <span aria-hidden="true">↗</span></a> : name}
            </h3>
            <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.7);">This partner will offer discounts / benefits for SwimParty 10km participants — details coming soon.</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="panel py-20">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="section-heading mb-6">Getting to the Algarve</h2>
      <hr class="carrd-rule" />
      <ul class="bullets" style="color:rgba(255,255,255,0.85);">
        <li>Our rental car partner <a href="https://autorent.pt/pt" target="_blank" rel="noopener noreferrer" style="color:#DF206C;text-decoration:none;">Auto Rent</a> will offer discounts / benefits for SwimParty 10km participants — details coming soon</li>
        <li>Faro Airport (FAO) — approximately 50 min drive to Carvoeiro</li>
        <li>Direct flights from London, Lisbon, Amsterdam, Porto and more</li>
        <li>Sea temperature in September: 21–24°C</li>
        <li>Wetsuit optional — conditions are typically calm</li>
      </ul>
    </div>
  </section>

</Base>

<style>
  .btn-inline-pink {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1rem;
    padding: 0.6rem 1.5rem;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.2rem;
    color: #DF206C;
    border: 2px solid #DF206C;
    text-decoration: none;
    transition: transform 0.25s ease, background-color 0.25s ease, color 0.25s ease;
  }
  .btn-inline-pink:hover {
    transform: scale(1.0425);
    background-color: #DF206C;
    color: #ffffff;
  }

  .hotel-link {
    color: #DF206C;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .hotel-link:hover {
    color: #ffffff;
  }
  .hotel-link span {
    display: inline-block;
    font-size: 0.65em;
    vertical-align: middle;
    transition: transform 0.2s ease;
  }
  .hotel-link:hover span {
    transform: translate(0.15em, -0.15em);
  }
</style>

